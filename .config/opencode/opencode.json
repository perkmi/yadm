{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3.8:27b-mtp-q8_0",
  "plugins": ["opencode-tps-meter"],
  "providers": {
    "ollama": {
      "settings": {
        "baseURL": "http://192.168.1.15:11434/v1"
      },
      "models": {
        "qwen3.8:27b-mtp-q8_0": {
          "name": "Qwen3.8 27B (Ollama)"
        },
        "muse-glimmer:30b-q8_0-dflash": {
          "name": "Muse Glimmer (Ollama)"
        },
        "gpt-oss:120b": {
          "name": "GPT-OSS 120B (Ollama)"
        }
      }
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "~/opencode/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/usr/include/*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "/usr/include/*",
      "effect": "deny"
    }
  ]
}
